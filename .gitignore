<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AM Web Studio</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    * { margin:0; padding:0; box-sizing:border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background:#fff;
      color:#333;
    }

    header {
      background:#ff4da6;
      color:white;
      text-align:center;
      padding:20px;
      font-family:'Poppins', sans-serif;
    }

    nav {
      display:flex;
      justify-content:center;
      gap:20px;
      padding:15px;
      background:#fff0f6;
    }

    nav a {
      text-decoration:none;
      color:#ff4da6;
      font-weight:600;
    }

    .hero {
      text-align:center;
      padding:80px 20px;
    }

    .hero h2 {
      color:#ff4da6;
      font-size:32px;
      font-family:'Poppins', sans-serif;
    }

    .btn {
      display:inline-block;
      margin-top:20px;
      background:#ff4da6;
      color:white;
      padding:12px 20px;
      border-radius:8px;
      text-decoration:none;
      font-weight:600;
    }

    .section {
      padding:60px 20px;
      text-align:center;
    }

    .section h2 {
      color:#ff4da6;
      margin-bottom:15px;
      font-family:'Poppins', sans-serif;
    }

    .services {
      display:flex;
      justify-content:center;
      gap:20px;
      flex-wrap:wrap;
      margin-top:20px;
    }

    .card {
      background:#fff0f6;
      padding:20px;
      width:250px;
      border-radius:10px;
      border:1px solid #ffb3d9;
    }

    footer {
      background:#ff4da6;
      color:white;
      text-align:center;
      padding:15px;
      margin-top:30px;
    }
  </style>
</head>

<body>

<header>
  <h1>AM Web Studio</h1>
  <p>Criação de sites modernos e profissionais</p>
</header>

<nav>
  <a href="#sobre">Sobre</a>
  <a href="#servicos">Serviços</a>
  <a href="#contato">Contato</a>
</nav>

<!-- HERO -->
<section class="hero">
  <h2>Seu negócio precisa estar online</h2>
  <p>Crio sites profissionais para você vender mais e crescer na internet</p>

  <a class="btn"
     href="https://wa.me/5517991300415?text=Olá!%20Vim%20pelo%20seu%20site"
     target="_blank">
    Falar comigo no WhatsApp
  </a>
</section>

<!-- SOBRE -->
<section id="sobre" class="section">
  <h2>Sobre</h2>
  <p>
    Criamos sites modernos, personalizados e focados em resultados.
    Nosso objetivo é ajudar seu negócio a crescer no digital.
  </p>
</section>

<!-- SERVIÇOS -->
<section id="servicos" class="section">
  <h2>Serviços</h2>

  <div class="services">
    <div class="card">
      <h3>Sites profissionais</h3>
      <p>Sites completos para empresas.</p>
    </div>

    <div class="card">
      <h3>Landing Pages</h3>
      <p>Páginas para vendas e conversão.</p>
    </div>

    <div class="card">
      <h3>Otimização</h3>
      <p>Sites rápidos e otimizados para Google.</p>
    </div>
  </div>
</section>

<!-- CONTATO -->
<section id="contato" class="section">
  <h2>Contato</h2>
  <p>Entre em contato pelo WhatsApp:</p>

  <a class="btn"
     href="https://wa.me/5517991300415?text=Olá!%20Quero%20um%20site"
     target="_blank">
    Chamar no WhatsApp
  </a>
</section>

<footer>
  <p>© 2026 AM Web Studio</p>
</footer>

</body>
</html>